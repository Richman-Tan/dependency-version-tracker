<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Sandfield.Portal" Version="7.13.0" />
    <PackageReference Include="Sandfield.WebAPI" Version="7.*" />
    <PackageReference Include="AWSSDK.BedrockAgentRuntime" Version="4.0.8.8" />
    <!-- <PackageReference Include="Sandfield.WebRequest" Version="1.3.3" /> -->
    <PackageReference Include="GitVersion.MsBuild" Version="6.5.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ChildVersionPackage">
      <Version>3.2.1</Version>
    </PackageReference>
    <PackageReference Update="UpdatedPackage" Version="1.0.0" />
    <PackageReference Include="NoVersionPackage" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

</Project>
